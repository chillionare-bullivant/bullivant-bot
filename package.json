    "run:express": "node cli-express.cjs",
    "run:vars": "node variables-functions.js",
    "run:objects": "node objects-arrays.js",
    "run:async": "node async-demo.js",
    "run:destructure": "node destructuring-concepts.js",
    "run:scanner": "node scanner.js",
    "run:btc": "node btc-node-client.js",
    "run:multichain": "node multi-chain-client.js",
    "run:custodial": "node custodial-microservices.cjs",
    "run:node": "node node.js",
    "run:p2p": "node p2p-node.cjs",
    "run:vm": "node smart-contract-vm-engine.cjs",
    "run:bot": "node run-bot-24-7.js",
